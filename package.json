{
  "name": "dmx-sim",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
      "dev": "npm run dev -w @dmxsim/lighting-spike",
      "build": "npm run build -w @dmxsim/lighting-spike",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty",
    "bench:report": "vite-node --config apps/lighting-spike/vite.config.ts apps/lighting-spike/scripts/perf-report.ts",
    "project:generate": "vite-node --config apps/lighting-spike/vite.config.ts apps/lighting-spike/scripts/generate-demo-project.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vitest": "^3.0.4"
  }
}
