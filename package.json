{
  "name": "dmx-sim",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @dmxsim/studio",
    "build": "npm run build -w @dmxsim/studio",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "knip": "knip",
    "check": "npm run typecheck && npm run lint && npm run knip && npm test",
    "bench:report": "vite-node --config apps/studio/vite.config.ts apps/studio/scripts/perf-report.ts",
    "project:generate": "vite-node --config apps/studio/vite.config.ts apps/studio/scripts/generate-demo-project.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "eslint": "^10.13.0",
    "knip": "^6.42.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.0.11",
    "vite-node": "^3.2.4",
    "vitest": "^3.0.4"
  }
}
